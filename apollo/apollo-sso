#!/usr/bin/env python3
"""apollo-sso: lightweight club-wide SSO for apollo backed by Gitea's OAuth2/OIDC provider.

Runs on 127.0.0.1:3005 behind nginx at /sso/ and serves nginx auth_request subrequests at /verify.
Any app behind nginx can read verified headers:
  X-Apollo-User    Gitea username (e.g. qstyban)
  X-Apollo-Name    Display name (e.g. Alex Rivera)
  X-Apollo-Groups  Comma-separated Gitea org:team groups
  X-Apollo-Admin   "1" if member of any :Owners team, else "0"

Config: /etc/apollo-sso/config.json (mode 0640, root:apollo-sso).
"""
import base64
import hashlib
import hmac
import html
import json
import os
import secrets
import signal
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = os.environ.get("APOLLO_SSO_HOST", "127.0.0.1")
PORT = int(os.environ.get("APOLLO_SSO_PORT", "3005"))
CONFIG_PATH = os.environ.get("APOLLO_SSO_CONFIG", "/etc/apollo-sso/config.json")

SESSION_COOKIE = "apollo_session"
STATE_COOKIE = "apollo_sso_state"
STATE_TTL = 600
DEFAULT_SESSION_TTL = 7 * 86400


def b64u_encode(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def b64u_decode(text):
    pad = "=" * (-len(text) % 4)
    return base64.urlsafe_b64decode(text + pad)


def sign_token(payload, secret):
    body = b64u_encode(json.dumps(payload, separators=(",", ":"), ensure_ascii=False).encode("utf8"))
    sig = hmac.new(secret.encode("utf8"), body.encode("ascii"), hashlib.sha256).digest()
    return body + "." + b64u_encode(sig)


def verify_token(token, secret, now=None):
    if not token or "." not in token or not secret:
        return None
    body, sig_b64 = token.split(".", 1)
    expected = b64u_encode(hmac.new(secret.encode("utf8"), body.encode("ascii"), hashlib.sha256).digest())
    if not hmac.compare_digest(sig_b64, expected):
        return None
    try:
        data = json.loads(b64u_decode(body).decode("utf8"))
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    now = time.time() if now is None else float(now)
    if float(data.get("exp") or 0) <= now:
        return None
    return data


def safe_next(target):
    """Allow only local relative paths (never //evil.com or external URLs)."""
    s = str(target or "/").strip()
    if not s.startswith("/") or s.startswith("//") or "\\" in s or "\r" in s or "\n" in s:
        return "/"
    return s


def pkce_challenge(verifier):
    return b64u_encode(hashlib.sha256(verifier.encode("ascii")).digest())


def is_admin_groups(groups):
    return any(str(g).lower().endswith(":owners") for g in (groups or []))


def clean_header_value(value):
    return " ".join(str(value or "").replace("\r", " ").replace("\n", " ").split())[:120]


def load_config(path=CONFIG_PATH):
    try:
        with open(path, encoding="utf8") as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def is_configured(cfg):
    return bool(
        cfg.get("client_id")
        and cfg.get("client_secret")
        and cfg.get("session_secret")
        and cfg.get("gitea_public_url")
        and cfg.get("redirect_uri")
    )


