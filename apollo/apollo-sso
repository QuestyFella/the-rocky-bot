class GiteaClient:
    """Server-to-server OAuth2 code exchange and OIDC userinfo lookup against Gitea."""

    def exchange_and_userinfo(self, cfg, code, verifier):
        internal = str(cfg.get("gitea_internal_url") or cfg["gitea_public_url"]).rstrip("/")
        form = urllib.parse.urlencode({
            "client_id": cfg["client_id"],
            "client_secret": cfg["client_secret"],
            "code": code,
            "redirect_uri": cfg["redirect_uri"],
            "code_verifier": verifier,
            "grant_type": "authorization_code",
        }).encode("utf8")
        req = urllib.request.Request(
            internal + "/login/oauth/access_token",
            data=form,
            headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            tok = json.loads(resp.read().decode("utf8"))
        access_token = tok.get("access_token")
        if not access_token:
            raise RuntimeError(tok.get("error_description") or tok.get("error") or "no access_token returned")

        ureq = urllib.request.Request(
            internal + "/login/oauth/userinfo",
            headers={"Authorization": f"Bearer {access_token}", "Accept": "application/json"},
        )
        with urllib.request.urlopen(ureq, timeout=10) as resp:
            info = json.loads(resp.read().decode("utf8"))
        user = clean_header_value(info.get("preferred_username") or info.get("sub") or "")
        if not user:
            raise RuntimeError("userinfo missing preferred_username")
        name = clean_header_value(info.get("name") or user)
        groups = [clean_header_value(g) for g in (info.get("groups") or []) if g]
        return {"u": user, "n": name, "g": groups}


def make_handler(config_loader=load_config, gitea=None):
    gitea = gitea or GiteaClient()

    class SSOHandler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))
            sys.stderr.flush()

        def _cookies(self):
            c = SimpleCookie()
            raw = self.headers.get("Cookie")
            if raw:
                try:
                    c.load(raw)
                except Exception:
                    pass
            return {k: m.value for k, m in c.items()}

        def _session(self, cfg):
            tok = self._cookies().get(SESSION_COOKIE)
            return verify_token(tok, cfg.get("session_secret") or "")

        def _send(self, code, body, content_type, headers=None, cookies=None):
            data = body.encode("utf8") if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (headers or {}).items():
                self.send_header(k, v)
            for c in (cookies or []):
                self.send_header("Set-Cookie", c)
            self.end_headers()
            self.wfile.write(data)

        def _redirect(self, location, cookies=None):
            self._send(302, "", "text/plain; charset=utf-8", {"Location": location}, cookies=cookies)

        def _cookie_str(self, name, value, path="/", max_age=None):
            parts = [f"{name}={value}", f"Path={path}", "HttpOnly", "SameSite=Lax"]
            if max_age is not None:
                parts.append(f"Max-Age={int(max_age)}")
            if self.headers.get("X-Forwarded-Proto") == "https":
                parts.append("Secure")
            return "; ".join(parts)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            path = parsed.path
            qs = urllib.parse.parse_qs(parsed.query)
            cfg = config_loader()

            if path == "/health":
                self._send(200, json.dumps({"ok": True, "configured": is_configured(cfg)}), "application/json; charset=utf-8")
                return

            if path == "/verify":
                optional = (qs.get("optional") or [""])[0] == "1"
                configured = is_configured(cfg)
                sess = self._session(cfg) if configured else None
                if sess:
                    groups = sess.get("g") or []
                    hdrs = {
                        "X-Apollo-SSO": "1",
                        "X-Apollo-User": clean_header_value(sess.get("u")),
                        "X-Apollo-Name": clean_header_value(sess.get("n") or sess.get("u")),
                        "X-Apollo-Groups": ",".join(clean_header_value(g) for g in groups),
                        "X-Apollo-Admin": "1" if is_admin_groups(groups) else "0",
                    }
                    self._send(200, "", "text/plain; charset=utf-8", hdrs)
                elif optional:
                    self._send(200, "", "text/plain; charset=utf-8", {
                        "X-Apollo-SSO": "1" if configured else "0",
                        "X-Apollo-User": "", "X-Apollo-Name": "", "X-Apollo-Groups": "", "X-Apollo-Admin": "0",
                    })
                else:
                    self._send(401, "Unauthorized", "text/plain; charset=utf-8")
                return

            if path == "/whoami":
                sess = self._session(cfg) if is_configured(cfg) else None
                if sess:
                    groups = sess.get("g") or []
                    obj = {
                        "configured": True,
                        "authenticated": True,
                        "user": sess.get("u"),
                        "name": sess.get("n") or sess.get("u"),
                        "groups": groups,
                        "admin": is_admin_groups(groups),
                    }
                else:
                    obj = {"configured": is_configured(cfg), "authenticated": False}
                self._send(200, json.dumps(obj, ensure_ascii=False), "application/json; charset=utf-8")
                return

            if path == "/login":
                if not is_configured(cfg):
                    body = (
                        "<p class='err'>Apollo SSO is not configured yet.</p>"
                        "<p class='dim'>Create an OAuth2 application in Gitea with redirect URI "
                        "<code>http://10.16.26.107/sso/callback</code>, then save its client ID and secret "
                        "in <code>/etc/apollo-sso/config.json</code>.</p>"
                        "<a class='btn sec' href='/'>Back to apollo</a>"
                    )
                    self._send(503, render_page("sso setup", body), "text/html; charset=utf-8")
                    return
                nxt = safe_next((qs.get("next") or ["/"])[0])
                state = secrets.token_urlsafe(24)
                verifier = secrets.token_urlsafe(32)
                st_tok = sign_token(
                    {"state": state, "verifier": verifier, "next": nxt, "exp": int(time.time()) + STATE_TTL},
                    cfg["session_secret"],
                )
                params = urllib.parse.urlencode({
                    "client_id": cfg["client_id"],
                    "redirect_uri": cfg["redirect_uri"],
                    "response_type": "code",
                    "scope": "openid profile email groups",
                    "state": state,
                    "code_challenge": pkce_challenge(verifier),
                    "code_challenge_method": "S256",
                })
                auth_url = cfg["gitea_public_url"].rstrip("/") + "/login/oauth/authorize?" + params
                self._redirect(auth_url, cookies=[self._cookie_str(STATE_COOKIE, st_tok, path="/sso/", max_age=STATE_TTL)])
                return

            if path == "/callback":
                if not is_configured(cfg):
                    self._send(503, render_page("sso error", "<p class='err'>SSO not configured.</p>"), "text/html; charset=utf-8")
                    return
                if qs.get("error"):
                    err_txt = html.escape((qs.get("error_description") or qs["error"])[0])
                    body = f"<p class='err'>Gitea sign-in cancelled or denied: {err_txt}</p><a class='btn sec' href='/'>Back</a>"
                    self._send(400, render_page("sign-in error", body), "text/html; charset=utf-8")
                    return
                code = (qs.get("code") or [""])[0]
                state = (qs.get("state") or [""])[0]
                st_data = verify_token(self._cookies().get(STATE_COOKIE), cfg["session_secret"])
                if not code or not st_data or not hmac.compare_digest(state, str(st_data.get("state") or "")):
                    body = (
                        "<p class='err'>Sign-in session expired or invalid state.</p>"
                        "<a class='btn' href='/sso/login'>Try again</a>"
                    )
                    self._send(400, render_page("sign-in error", body), "text/html; charset=utf-8")
                    return
                try:
                    profile = gitea.exchange_and_userinfo(cfg, code, st_data["verifier"])
                except Exception as e:
                    sys.stderr.write(f"OAuth2 callback failed: {e}\n")
                    sys.stderr.flush()
                    body = (
                        f"<p class='err'>Could not complete Gitea sign-in ({html.escape(type(e).__name__)}).</p>"
                        "<a class='btn' href='/sso/login'>Try again</a>"
                    )
                    self._send(502, render_page("sign-in error", body), "text/html; charset=utf-8")
                    return
                ttl = int(cfg.get("session_ttl") or DEFAULT_SESSION_TTL)
                profile["exp"] = int(time.time()) + ttl
                sess_tok = sign_token(profile, cfg["session_secret"])
                cookies = [
                    self._cookie_str(SESSION_COOKIE, sess_tok, path="/", max_age=ttl),
                    self._cookie_str(STATE_COOKIE, "", path="/sso/", max_age=0),
                ]
                self._redirect(safe_next(st_data.get("next")), cookies=cookies)
                return

            if path == "/logout":
                nxt = safe_next((qs.get("next") or ["/"])[0])
                self._redirect(nxt, cookies=[self._cookie_str(SESSION_COOKIE, "", path="/", max_age=0)])
                return

            if path in ("/", "/index.html"):
                if not is_configured(cfg):
                    body = (
                        "<p class='err'>Gitea OAuth2 is not configured yet.</p>"
                        "<p class='dim'>Add <code>client_id</code> and <code>client_secret</code> to "
                        "<code>/etc/apollo-sso/config.json</code> and restart <code>apollo-sso</code>.</p>"
                    )
                else:
                    sess = self._session(cfg)
                    if sess:
                        u = html.escape(sess.get("u") or "")
                        n = html.escape(sess.get("n") or u)
                        groups = sess.get("g") or []
                        g_html = "".join(f"<li><code>{html.escape(g)}</code></li>" for g in groups) or "<li class='dim'>none</li>"
                        body = (
                            f"<p class='ok'>Signed in as <strong>{n}</strong> (<code>@{u}</code>)</p>"
                            f"<p class='dim'>Teams:</p><ul>{g_html}</ul>"
                            "<a class='btn' href='/borrow/'>Borrow Tracker</a>"
                            "<a class='btn sec' href='/gitea/'>Gitea</a>"
                            "<a class='btn sec' href='/sso/logout?next=/sso/'>Sign out</a>"
                        )
                    else:
                        body = (
                            "<p>Sign in once with your UofG Rocketry Gitea account to use club tools on apollo.</p>"
                            "<a class='btn' href='/sso/login?next=/sso/'>Sign in with Apollo Gitea</a>"
                            "<a class='btn sec' href='/borrow/'>View Borrow Tracker</a>"
                        )
                self._send(200, render_page("sso", body), "text/html; charset=utf-8")
                return

            self._send(404, "Not found", "text/plain; charset=utf-8")

    return SSOHandler


def configure_cli():
    """Interactive helper (run with sudo): saves Gitea OAuth2 Client ID & Secret to CONFIG_PATH."""
    cfg = load_config(CONFIG_PATH)
    print(f"Configuring Apollo SSO ({CONFIG_PATH})")
    print("In Gitea -> Settings / Site Admin -> Applications -> Create OAuth2 Application:")
    print("  Application Name: Apollo SSO")
    print("  Redirect URI:     http://10.16.26.107/sso/callback")
    print("  Confidential:     checked")
    print()
    cid = input(f"Client ID [{cfg.get('client_id') or ''}]: ").strip() or cfg.get("client_id") or ""
    csec = input("Client Secret (leave blank to keep existing): ").strip() or cfg.get("client_secret") or ""
    if not (cid and csec):
        print("Both Client ID and Client Secret are required.", file=sys.stderr)
        sys.exit(1)
    cfg.update({
        "client_id": cid,
        "client_secret": csec,
        "session_secret": cfg.get("session_secret") or secrets.token_hex(32),
        "gitea_public_url": cfg.get("gitea_public_url") or "http://10.16.26.107/gitea",
        "gitea_internal_url": cfg.get("gitea_internal_url") or "http://127.0.0.1:3000",
        "redirect_uri": cfg.get("redirect_uri") or "http://10.16.26.107/sso/callback",
        "session_ttl": int(cfg.get("session_ttl") or DEFAULT_SESSION_TTL),
    })
    os.makedirs(os.path.dirname(os.path.abspath(CONFIG_PATH)), exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf8") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o640)
    os.replace(tmp, CONFIG_PATH)
    print(f"Saved {CONFIG_PATH}. Restart with: sudo systemctl restart apollo-sso")


def main():
    if "--configure" in sys.argv:
        configure_cli()
        return
    server = ThreadingHTTPServer((HOST, PORT), make_handler())
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"apollo-sso listening on http://{HOST}:{PORT} (config: {CONFIG_PATH})", file=sys.stderr, flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
