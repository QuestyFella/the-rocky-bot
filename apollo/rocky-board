"""rocky-board: show the club's Discord task boards (main, rocketry, liquid-rocket) full-screen in a terminal.

  rocky-board            live board (q to quit, space / arrows / PgUp / PgDn to change page)
  rocky-board --once     print the board once and exit
  rocky-board --kiosk    apollo's monitor mode (used by rocky-board-kiosk.service): only the
                         page keys work (no auto-switching), B/R open the borrow/return form,
                         !buzz shows an overlay (apollo-sound plays the tune), and S flips the shop sign.

Reads the snapshot written by rocky-board-export (refreshed every 15 seconds).
"""
import signal
import sys
import termios

KIOSK = "--kiosk" in sys.argv


def lock_keyboard():
    """Kiosk mode: make the keyboard unable to stop, pause or freeze the board.

    The main protection is in rocky-board-kiosk.service: the board only writes to the
    monitor and never has it as its controlling terminal, so Ctrl-C/Ctrl-\\/Ctrl-Z have
    no program to send a signal to. This adds two more layers, first thing at startup:
      - the terminal: ISIG off (those keys make no signals), IXON off (Ctrl-S can't pause
        the screen, and turning it off un-pauses a screen someone already paused),
        BRKINT off (no signal from Break), ECHO/ICANON/IEXTEN off (typed keys never show)
      - the program: those signals are ignored even if something else sends them
    """
    for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGHUP, signal.SIGTTIN, signal.SIGTTOU):
        signal.signal(s, signal.SIG_IGN)
    for fd in (1, 0):                      # stdout is the monitor in kiosk mode
        try:
            a = termios.tcgetattr(fd)
        except termios.error:
            continue
        a[0] &= ~(termios.IXON | termios.IXOFF | termios.IXANY | termios.BRKINT)
        a[3] &= ~(termios.ISIG | termios.ICANON | termios.ECHO | termios.IEXTEN)
        a[6][termios.VMIN], a[6][termios.VTIME] = 1, 0
        termios.tcsetattr(fd, termios.TCSANOW, a)
        break


if KIOSK:
    lock_keyboard()

