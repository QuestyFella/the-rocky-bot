def shown_boards(snap):
    """Boards to page through: main always, the others while they have open tasks."""
    boards = snap.get("boards") or [snap]
    return [b for b in boards if b.get("name", "main") == "main"
            or b["counts"]["ready"] + b["counts"]["progress"] + b["counts"]["waiting"]] or boards[:1]


def frame(snap, err, page_no, w, h, space=None, space_err=None, now=None, borrow=None, borrow_err=None):
    now_ts = time.time() if now is None else float(now)
    now_str = datetime.fromtimestamp(now_ts).astimezone().strftime("%a %d %b  %H:%M")
    badge = ROOM.badge() if ROOM else None
    side = ([badge, ("", " ")] if badge else []) + [(REV, " " + now_str + " ")]
    header = lambda title: render([(REV + BOLD, fit(" " + clean(title).upper() + " ", max(1, w - sum(width(t) for _, t in side) - 1)))] + side, w)
    if not snap and not space and not space_err and not borrow and not borrow_err:
        lines = [header("Task Board"), render([(color("red", True), err or "")], w)]
        return lines + [" " * w] * (h - len(lines)), 1

    cols = 1 if ONCE else max(1, min(3, w // 56))
    gap = 3
    colw = (w - gap * (cols - 1)) // cols
    countdown = launch_text(snap.get("launch")) if snap else None

    board_extra = []
    if countdown:
        board_extra.append(render([(color("red", True), " >> " + countdown)], w))
    if snap:
        age = now_ts - datetime.fromisoformat(snap["generatedAt"]).timestamp()
        if age > STALE_SECONDS:
            board_extra.append(render([(color("red", True), f" Board data is {int(age // 60)} min old - the exporter may be stopped.")], w))

    space_extra = []
    if countdown:
        space_extra.append(render([(color("red", True), " >> " + countdown)], w))
    if space:
        try:
            sage = now_ts - datetime.fromisoformat(space["generatedAt"].replace("Z", "+00:00")).timestamp()
            if sage > SPACE_STALE_SECONDS:
                space_extra.append(render([(color("red", True), f" Space data is {int(sage // 60)} min old - rocky-space-export may be stopped.")], w))
        except (KeyError, ValueError, AttributeError):
            pass

    borrow_extra = []
    if countdown:
        borrow_extra.append(render([(color("red", True), " >> " + countdown)], w))

    pages = []
    tab_names = []
    if snap:
        b_rows = max(4, h - (3 + len(board_extra)) - 2)
        for b in shown_boards(snap):
            tab_names.append(clean(b.get("name", "main")))
            for p in layout(b, cols, colw, b_rows):
                pages.append(("board", b, p, b_rows))
    elif err:
        tab_names.append("main")
        pages.append(("board_err", None, None, max(4, h - 5)))

    if space:
        s_rows = max(4, h - (3 + len(space_extra)) - 2)
        tab_names.append("space")
        for p in space_layout(space, cols, colw, s_rows, now_ts):
            pages.append(("space", space, p, s_rows))
    elif space_err:
        tab_names.append("space")
        pages.append(("space_err", None, None, max(4, h - 5)))

    if borrow:
        br_rows = max(4, h - (3 + len(borrow_extra)) - 2)
        tab_names.append("borrow")
        for p in borrow_layout(borrow, cols, colw, br_rows, now_ts):
            pages.append(("borrow", borrow, p, br_rows))
    elif borrow_err:
        tab_names.append("borrow")
        pages.append(("borrow_err", None, None, max(4, h - 5)))

    page_no %= len(pages)
    kind, obj, page, rows = pages[page_no]
    borrow_hint = "  -  B borrow / R return" if borrow is not None else ""

    if kind == "board":
        c = obj["counts"]
        lines = [header(obj["title"]),
                 render([(color("yellow", True), f" {c['progress']} in progress"), ("", "   "),
                         (color("green", True), f"{c['ready']} ready to claim"), ("", "   "),
                         (DIM, f"{c['waiting']} locked   {c['done']} done")], w),
                 *board_extra, " " * w]
        active_tab = clean(obj.get("name", "main"))
        updated = datetime.fromisoformat(snap["generatedAt"]).astimezone().strftime("%H:%M:%S")
        footer = f"page {page_no + 1}/{len(pages)}  -  updated {updated}{borrow_hint}  -  Discord: Find Work, or !task"
    elif kind == "board_err":
        lines = [header("Task Board"), render([(color("red", True), " " + (err or ""))], w)]
        lines += [" " * w] * max(0, h - len(lines) - 2)
        active_tab = "main"
        footer = f"page {page_no + 1}/{len(pages)}{borrow_hint}"
    elif kind == "space":
        loc_name = clean((obj.get("location") or {}).get("name") or "")
        title = f"Space Dashboard ({loc_name})" if loc_name else "Space Dashboard"
        lines = [header(title), render(space_summary(obj, now_ts), w), *space_extra, " " * w]
        active_tab = "space"
        try:
            supd = datetime.fromisoformat(obj["generatedAt"].replace("Z", "+00:00")).astimezone().strftime("%H:%M")
        except (KeyError, ValueError, AttributeError):
            supd = "?"
        footer = f"page {page_no + 1}/{len(pages)}  -  space updated {supd}{borrow_hint}  -  Space/arrows to turn"
    elif kind == "space_err":
        lines = [header("Space Dashboard"), render([(color("red", True), " " + (space_err or ""))], w)]
        lines += [" " * w] * max(0, h - len(lines) - 2)
        active_tab = "space"
        footer = f"page {page_no + 1}/{len(pages)}{borrow_hint}"
    elif kind == "borrow":
        n_out = len(obj.get("active") or [])
        lines = [header("Borrowed Equipment"),
                 render([(color("yellow", True), f" {n_out} currently out"), ("", "   "),
                         (color("cyan", True), "Press B to borrow"), ("", "   "),
                         (color("green", True), "R to return"), ("", "   "),
                         (DIM, clean(BORROW_WEB_HINT))], w),
                 *borrow_extra, " " * w]
        active_tab = "borrow"
        footer = f"page {page_no + 1}/{len(pages)}  -  B borrow  -  R return  -  {clean(BORROW_WEB_HINT)}"
    else:
        lines = [header("Borrowed Equipment"), render([(color("red", True), " " + (borrow_err or ""))], w)]
        lines += [" " * w] * max(0, h - len(lines) - 2)
        active_tab = "borrow"
        footer = f"page {page_no + 1}/{len(pages)}"

    if page is not None:
        draw_rows = max((len(c) for c in page), default=0) if ONCE else rows
        pad = " " * max(0, w - (colw * cols + gap * (cols - 1)))
        for r in range(draw_rows):
            segs = []
            for ci in range(cols):
                cell = page[ci][r] if r < len(page[ci]) else [("", "")]
                segs.append(render(cell, colw))
            lines.append((" " * gap).join(segs) + pad)

    tabs = []
    for name in tab_names:
        tabs += [(REV + BOLD, f" {name} ") if name == active_tab else (DIM, f" {name} "), ("", " ")]
    lines.append(" " * w)
    lines.append(render([("", " ")] + (tabs + [("", "  ")] if len(tab_names) > 1 else []) + [(DIM, footer)], w))
    out = lines[:h]
    if BORROW:
        out = BORROW.overlay(out, borrow, w, h, now_ts)
    if ROOM:
        out = ROOM.overlay(out, w, h)
    return out, len(pages)


def read_json(path):
    try:
        with open(path, encoding="utf8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


class Room:
    """The buzz box and the shop sign. (The !buzz tune is apollo-sound's job: it owns the speakers.)"""

    def __init__(self):
        self.buzz, self.buzz_until, self.shop, self.pending, self.last_press = None, 0, None, None, 0
        self.seen = (read_json(BUZZ_FILE) or {}).get("id")        # never show a buzz from before we started

    def poll(self):
        b = read_json(BUZZ_FILE)
        if isinstance(b, dict) and b.get("id") and b["id"] != self.seen:
            self.seen = b["id"]
            try:
                fresh = time.time() - datetime.fromisoformat(b["at"].replace("Z", "+00:00")).timestamp() < 120
            except (KeyError, ValueError, AttributeError):
                fresh = False
            if fresh:
                self.buzz, self.buzz_until = b, time.time() + BUZZ_SECONDS
        if self.buzz and time.time() > self.buzz_until:
            self.buzz = None
        s = read_json(SHOP_FILE)
        self.shop = s if isinstance(s, dict) and isinstance(s.get("open"), bool) else None
        if self.pending and self.shop and self.shop["open"] == self.pending["open"]:
            self.pending = None

    def toggle_shop(self):
        if not (KIOSK and REQUEST_DIR) or time.time() - self.last_press < 2:
            return
        self.last_press = time.time()
        now_open = self.pending["open"] if self.pending else bool(self.shop and self.shop["open"])
        self.pending = {"open": not now_open, "at": time.time()}
        req = {"id": uuid.uuid4().hex, "open": not now_open, "at": int(time.time() * 1000)}
        path = os.path.join(REQUEST_DIR, "shop-request.json")
        try:
            with open(path + ".tmp", "w", encoding="utf8") as f:
                json.dump(req, f)
            os.chmod(path + ".tmp", 0o644)
            os.replace(path + ".tmp", path)
        except OSError:
            self.pending = None

    def badge(self):
        """The shop sign for the header, or None when there's no shop state yet."""
        if self.pending:
            waited = time.time() - self.pending["at"]
            word = "OPENING" if self.pending["open"] else "CLOSING"
            return (color("yellow", True) + REV, f" SHOP {word}{'...' if waited < 30 else ' - bot not answering'} ")
        if self.shop:
            return (color("green" if self.shop["open"] else "red", True) + REV,
                    " SHOP OPEN " if self.shop["open"] else " SHOP CLOSED ")
        return (DIM, " shop: press S ") if KIOSK and REQUEST_DIR else None

    def overlay(self, lines, w, h):
        """The buzz box over the middle of the board."""
        if not self.buzz:
            return lines
        bw = min(w - 4, 64)
        name = clean(str(self.buzz.get("name") or "someone"))
        note = clean(str(self.buzz.get("note") or ""))
        try:
            at = datetime.fromisoformat(self.buzz["at"].replace("Z", "+00:00")).astimezone().strftime("%H:%M")
        except (KeyError, ValueError, AttributeError):
            at = ""
        body = ["", "*  B U Z Z  *", "", f"{name} is at the door!"] + ([f'"{note}"'] if note else []) + \
               ["", f"{at} - #door-alarm on Discord", "(any key to dismiss)" if KIOSK else "", ""]
        box = [(REV + color("red", True), fit(" " * ((bw - width(t)) // 2) + t, bw)) for t in body]
        top = max(1, (h - len(box)) // 2)
        left = " " * ((w - bw) // 2)
        out = list(lines)
        for i, seg in enumerate(box):
            if top + i < len(out):
                out[top + i] = render([("", left), seg], w)
        return out


ROOM = None


class BorrowUI:
    """Interactive keyboard-only Borrow & Return form right on apollo's monitor."""

    FIELDS = (
        ("borrower", "Name",    "",    80),
        ("discord",  "Discord", "",    60),
        ("item",     "Item",    "",   120),
        ("qty",      "Qty",     "1",   12),
        ("unit",     "Units",   "pcs", 30),
    )

    def __init__(self, api_base=None):
        self.api_base = (api_base or BORROW_API).rstrip("/")
        self.mode = None            # None | "borrow" | "return" | "confirm_return"
        self.values = {}
        self.field_idx = 0
        self.sel_idx = 0
        self.confirm_loan = None
        self.error = ""
        self.last_activity = 0.0
        self.flash = None           # (text, is_err, until_ts)

    def active(self):
        return self.mode is not None

    def tick(self, now=None):
        now = time.time() if now is None else float(now)
        if self.mode and now - self.last_activity > BORROW_IDLE_SECONDS:
            self.mode = None
            self.error = ""
        if self.flash and now >= self.flash[2]:
            self.flash = None

    def _open_borrow(self, now):
        self.mode = "borrow"
        self.values = {k: default for k, _, default, _ in self.FIELDS}
        self.field_idx = 0
        self.error = ""
        self.last_activity = now

    def _open_return(self, now):
        self.mode = "return"
        self.sel_idx = 0
        self.confirm_loan = None
        self.error = ""
        self.last_activity = now

    def _post_json(self, path, payload):
        data = json.dumps(payload).encode("utf8")
        req = urllib.request.Request(
            self.api_base + path,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=3) as resp:
                return json.loads(resp.read().decode("utf8")), None
        except urllib.error.HTTPError as e:
            try:
                msg = json.loads(e.read().decode("utf8")).get("error") or f"HTTP {e.code}"
            except Exception:
                msg = f"HTTP {e.code}"
            return None, msg
        except Exception:
            return None, "Borrow service offline - try again in a moment."

    def _submit_borrow(self, now):
        for idx, (key, label, _, _) in enumerate(self.FIELDS):
            val = self.values.get(key, "").strip()
            if not val:
                self.field_idx = idx
                self.error = f"{label} is required."
                return
        try:
            qty = float(self.values["qty"].strip())
            if qty <= 0:
                raise ValueError
        except ValueError:
            self.field_idx = 3
            self.error = "Qty must be a positive number."
            return
        payload = {
            "borrower": self.values["borrower"].strip(),
            "discord": self.values["discord"].strip(),
            "item": self.values["item"].strip(),
            "qty": qty,
            "unit": self.values["unit"].strip() or "pcs",
            "source": "kiosk",
        }
        loan, err = self._post_json("/api/loans", payload)
        if err:
            self.error = err
            return
        self.mode = None
        self.error = ""
        self.flash = (f"BORROWED: {loan['qtyText']} {loan['unit']} {loan['item']} ({loan['borrower']})",
                      False, now + BORROW_FLASH_SECONDS)

    def _submit_return(self, now):
        loan = self.confirm_loan
        if not loan:
            self.mode = "return"
            return
        updated, err = self._post_json(f"/api/loans/{loan['id']}/return", {})
        if err:
            self.mode = "return"
            self.error = err
            return
        self.mode = None
        self.confirm_loan = None
        self.error = ""
        self.flash = (f"RETURNED: {updated['item']} ({updated['borrower']})",
                      False, now + BORROW_FLASH_SECONDS)

    def handle_key(self, key, borrow_data, now=None):
        now = time.time() if now is None else float(now)
        if self.mode is None:
            if borrow_data is None and "ROCKY_BORROW_URL" not in os.environ:
                return False
            if key in BORROW_KEYS:
                self._open_borrow(now)
                return True
            if key in RETURN_KEYS:
                self._open_return(now)
                return True
            return False

        self.last_activity = now
        if self.mode == "borrow":
            if key == b"\x1b":
                self.mode = None
                self.error = ""
            elif key == b"\t":
                self._open_return(now)
            elif key == b"\x1b[A":
                self.field_idx = max(0, self.field_idx - 1)
                self.error = ""
            elif key == b"\x1b[B":
                self.field_idx = min(len(self.FIELDS) - 1, self.field_idx + 1)
                self.error = ""
            elif key in (b"\r", b"\n"):
                if self.field_idx < len(self.FIELDS) - 1:
                    self.field_idx += 1
                    self.error = ""
                else:
                    self._submit_borrow(now)
            elif key in (b"\x7f", b"\x08"):
                fkey = self.FIELDS[self.field_idx][0]
                self.values[fkey] = self.values.get(fkey, "")[:-1]
                self.error = ""
            elif len(key) == 1 and 32 <= key[0] <= 126:
                ch = chr(key[0])
                fkey, _, _, maxlen = self.FIELDS[self.field_idx]
                cur = self.values.get(fkey, "")
                if fkey == "qty" and ch not in "0123456789.":
                    return True
                if len(cur) < maxlen:
                    self.values[fkey] = cur + ch
                    self.error = ""
            return True

        active = [x for x in ((borrow_data or {}).get("active") or []) if isinstance(x, dict)]
        if self.mode == "return":
            if key == b"\x1b":
                self.mode = None
                self.error = ""
            elif key == b"\t":
                self._open_borrow(now)
            elif key in (b"\x1b[A", b"k"):
                self.sel_idx = max(0, self.sel_idx - 1)
                self.error = ""
            elif key in (b"\x1b[B", b"j"):
                if active:
                    self.sel_idx = min(len(active) - 1, self.sel_idx + 1)
                self.error = ""
            elif key in (b"\r", b"\n") and active:
                self.sel_idx = min(self.sel_idx, len(active) - 1)
                self.confirm_loan = active[self.sel_idx]
                self.mode = "confirm_return"
                self.error = ""
            return True

        if self.mode == "confirm_return":
            if key in (b"\x1b", b"n", b"N"):
                self.mode = "return"
                self.confirm_loan = None
            elif key in (b"\r", b"\n", b"y", b"Y"):
                self._submit_return(now)
            return True

        return False

    def overlay(self, lines, borrow_data, w, h, now=None):
        now = time.time() if now is None else float(now)
        self.tick(now)
        out = list(lines)

        if self.mode is None:
            if not self.flash:
                return out
            msg, is_err, _ = self.flash
            style = REV + color("red" if is_err else "green", True)
            bw = min(w - 4, max(30, width(clean(msg)) + 4))
            left = " " * ((w - bw) // 2)
            row = max(1, h - 3)
            if row < len(out):
                out[row] = render([("", left), (style, fit("  " + clean(msg), bw))], w)
            return out

        bw = min(w - 4, 74)
        inner = bw - 4
        rows = []

        def box_line(segs, border_style=color("cyan", True)):
            return [(border_style, "| "), *segs, (border_style, " |")]

        def full_row(segs, border_style=color("cyan", True)):
            # Build exact width bw with borders
            used = 0
            mid = []
            for st, txt in segs:
                room = inner - used
                if room <= 0:
                    break
                t = fit(txt, room) if width(txt) > room else txt
                mid.append((st, t))
                used += width(t)
            if used < inner:
                mid.append(("", " " * (inner - used)))
            return [(border_style, "| "), *mid, (border_style, " |")]

        border = color("yellow", True) if self.mode == "borrow" else color("green", True)
        bar = [(border, "+" + "-" * (bw - 2) + "+")]
        rows.append(bar)

        if self.mode == "borrow":
            title = " BORROW AN ITEM   (Tab: Return  |  Esc: Cancel) "
            rows.append([(REV + color("yellow", True), fit(" " + title, bw))])
            rows.append(full_row([("", "")], border))
            for idx, (key, label, _, _) in enumerate(self.FIELDS):
                focused = idx == self.field_idx
                val = clean(self.values.get(key, ""))
                box_w = max(12, inner - 14)
                shown = val[-(box_w - 2):] if width(val) >= box_w - 1 else val
                cursor = "_" if focused else ""
                field_txt = f" {shown}{cursor}"
                lbl_style = color("yellow", True) if focused else DIM
                val_style = REV + BOLD if focused else ""
                rows.append(full_row([
                    (lbl_style, f"{'>' if focused else ' '} {label:<8} "),
                    (val_style, fit(field_txt, box_w)),
                ], border))
            rows.append(full_row([("", "")], border))
            if self.error:
                rows.append(full_row([(color("red", True), "  ! " + clean(self.error))], border))
            else:
                rows.append(full_row([(DIM, "  Enter: next field (Enter on Units to submit)  |  Up/Down: move")], border))
            rows.append(full_row([(DIM, f"  Shows up live at {clean(BORROW_WEB_HINT)}")], border))
        elif self.mode == "return":
            title = " RETURN AN ITEM   (Tab: Borrow  |  Esc: Cancel) "
            rows.append([(REV + color("green", True), fit(" " + title, bw))])
            rows.append(full_row([("", "")], border))
            active = [x for x in ((borrow_data or {}).get("active") or []) if isinstance(x, dict)]
            if not active:
                rows.append(full_row([(DIM, "  Nothing is currently borrowed.")], border))
            else:
                self.sel_idx = min(self.sel_idx, len(active) - 1)
                max_vis = max(3, min(8, h - 10))
                start = max(0, self.sel_idx - max_vis + 1)
                for i in range(start, min(len(active), start + max_vis)):
                    loan = active[i]
                    sel = i == self.sel_idx
                    qty = clean(loan.get("remainingText") or loan.get("qtyText") or "1")
                    unit = clean(loan.get("unit") or "pcs")
                    item = clean(loan.get("item") or "item")
                    who = clean(loan.get("borrower") or "?")
                    disc = clean(loan.get("discord") or "")
                    age = fmt_age(loan.get("borrowedAt"), now)
                    txt = f"{'> ' if sel else '  '}{item} ({qty} {unit}) - {who}"
                    if disc:
                        txt += f" @{disc}"
                    if age:
                        txt += f" [{age}]"
                    rows.append(full_row([(REV + BOLD if sel else "", fit(txt, inner))], border))
            rows.append(full_row([("", "")], border))
            if self.error:
                rows.append(full_row([(color("red", True), "  ! " + clean(self.error))], border))
            else:
                rows.append(full_row([(DIM, "  Up/Down: pick item  |  Enter: mark returned  |  Esc: cancel")], border))
        else:
            loan = self.confirm_loan or {}
            title = " CONFIRM RETURN "
            rows.append([(REV + color("green", True), fit(" " + title, bw))])
            rows.append(full_row([("", "")], border))
            qty = clean(loan.get("remainingText") or loan.get("qtyText") or "1")
            unit = clean(loan.get("unit") or "pcs")
            rows.append(full_row([(BOLD, f"  Return {qty} {unit} {clean(loan.get('item') or '')}?")], border))
            rows.append(full_row([(DIM, f"  Borrowed by {clean(loan.get('borrower') or '')} (@{clean(loan.get('discord') or '')})")], border))
            rows.append(full_row([("", "")], border))
            rows.append(full_row([(color("green", True), "  Enter / Y: confirm return   "), (DIM, "Esc / N: back")], border))

        rows.append(bar)
        top = max(1, (h - len(rows)) // 2)
        left = " " * ((w - bw) // 2)
        for i, segs in enumerate(rows):
            if top + i < len(out):
                out[top + i] = render([("", left)] + segs, w)
        return out


BORROW = None


def split_keys(data):
    """Bytes read from the keyboard as separate keys (a held key arrives several to a read)."""
    return re.findall(rb"\x1b\[[0-9;]*[~A-Za-z]|\x1b|.", data, re.S)


def main():
    if ONCE:
        snap, err = load()
        space, space_err = load_space()
        borrow, borrow_err = load_borrow()
        w, h = shutil.get_terminal_size((100, 40))
        out, page, npages = [], 0, 1
        while page < npages:                           # one page per board here
            lines, npages = frame(snap, err, page, w, 10_000, space=space, space_err=space_err,
                                  borrow=borrow, borrow_err=borrow_err)
            out.append("\n".join(l.rstrip() for l in lines).rstrip())
            page += 1
        try:
            print("\n\n".join(out))
        except BrokenPipeError:            # e.g. piped into head
            sys.stderr.close()
        return

    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    saved = termios.tcgetattr(fd) if fd is not None else None
    if KIOSK:
        # The keyboard was already locked out at startup (lock_keyboard). systemd restarts
        # the board if it ever exits anyway.
        sys.stdout.write("\033[9;0]\033[14;0]")       # never blank or power down the console
    else:
        sys.stdout.write("\033[?1049h")                # alternate screen: restores your terminal on exit
        if fd is not None:
            tty.setcbreak(fd)                          # read keys without Enter, don't echo; Ctrl-C still quits
    sys.stdout.write("\033[?25l\033[2J")               # hide cursor, clear

    if fd is not None:
        termios.tcflush(fd, termios.TCIFLUSH)          # drop keys typed before the board started
    global ROOM, BORROW
    ROOM = Room()
    BORROW = BorrowUI()
    page, page_started, hold, last_size = 0, time.time(), PAGE_SECONDS, None
    try:
        while True:
            w, h = shutil.get_terminal_size((100, 40))
            if (w, h) != last_size:
                sys.stdout.write("\033[2J")
                last_size = (w, h)
            snap, err = load()
            space, space_err = load_space()
            borrow, borrow_err = load_borrow()
            ROOM.poll()
            BORROW.tick()
            try:
                lines, npages = frame(snap, err, page, w, h, space=space, space_err=space_err,
                                      borrow=borrow, borrow_err=borrow_err)
            except Exception as e:                     # bad data must never take the board down
                traceback.print_exc()
                lines, npages = frame(None, f"Board data couldn't be shown ({type(e).__name__}). Retrying...", 0, w, h)
            sys.stdout.write("\033[H" + "\n".join(lines) + "\033[J")
            sys.stdout.flush()

            wait = 0.25 if BORROW.active() else 1.0
            ready = select.select([fd], [], [], wait)[0] if fd is not None else time.sleep(wait)
            if ready:
                data = os.read(fd, 64)
                if not data:                           # keyboard gone: keep showing the board
                    fd = None
                turned = False
                for key in split_keys(data):
                    if ROOM.buzz:                      # first key just dismisses the buzz box
                        ROOM.buzz, turned = None, True
                        continue
                    if BORROW.handle_key(key, borrow):
                        turned = True
                        page_started = time.time()
                        continue
                    if not KIOSK and key in (b"q", b"Q", b"\x1b"):
                        return
                    if key in SHOP_KEYS:
                        ROOM.toggle_shop()
                        turned = True
                        continue
                    step = 1 if key in NEXT_KEYS else -1 if key in PREV_KEYS else 0
                    if step:                           # every other key does nothing
                        page, turned = (page + step) % max(1, npages), True
                        page_started, hold = time.time(), HOLD_SECONDS if KIOSK else PAGE_SECONDS
                if turned:
                    continue                           # show the new page right away
            if BORROW.active() or PAGE_SECONDS <= 0:
                page_started = time.time()
            elif time.time() - page_started >= hold:
                page, page_started, hold = (page + 1) % max(1, npages), time.time(), PAGE_SECONDS
    except KeyboardInterrupt:
        pass
    finally:
        if fd is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write(RESET + "\033[?25h" + ("" if KIOSK else "\033[?1049l"))
        sys.stdout.flush()


if __name__ == "__main__":
    main()
