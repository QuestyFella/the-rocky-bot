def compass(deg):
    try:
        return COMPASS[int((float(deg) % 360.0 + 11.25) // 22.5) % 16]
    except (TypeError, ValueError):
        return "?"


def fmt_tminus(seconds):
    left = max(0, int(seconds))
    if left >= 86400:
        d, r = divmod(left, 86400)
        return f"T-{d}d {r // 3600:02}:{r % 3600 // 60:02}"
    h, r = divmod(left, 3600)
    return f"T-{h:02}:{r // 60:02}:{r % 60:02}"


def fmt_mmss(seconds):
    left = max(0, int(seconds))
    return f"{left // 60:02}:{left % 60:02}"


def fmt_pass_when(ts, now, compact_today=False):
    dt = datetime.fromtimestamp(ts).astimezone()
    today = datetime.fromtimestamp(now).astimezone().date()
    if dt.date() == today:
        return dt.strftime("%H:%M") if compact_today else "Today " + dt.strftime("%H:%M")
    return dt.strftime("%a %H:%M")


def fmt_age(iso_str, now):
    if not iso_str:
        return ""
    try:
        ts = datetime.fromisoformat(str(iso_str).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return ""
    age = max(0, int(now - ts))
    if age < 3600:
        return f"{max(1, age // 60)}m ago"
    if age < 86400:
        return f"{age // 3600}h ago"
    return f"{age // 86400}d ago"


def band_style(cond):
    c = str(cond or "").strip().lower()
    if c == "good":
        return color("green", True)
    if c == "fair":
        return color("yellow", True)
    if c == "poor":
        return color("red", True)
    return DIM


def num_style(val, warn, bad):
    try:
        n = float(val)
    except (TypeError, ValueError):
        return ""
    if n >= bad:
        return color("red", True)
    if n >= warn:
        return color("yellow", True)
    return color("green", True)


def bz_style(val):
    try:
        n = float(val)
    except (TypeError, ValueError):
        return ""
    if n <= -5.0:
        return color("red", True)
    if n < 0.0:
        return color("yellow", True)
    return color("green")


def xray_style(val):
    s = str(val or "").strip().upper()
    if s.startswith(("M", "X")):
        return color("red", True)
    if s.startswith("C"):
        return color("yellow", True)
    if s.startswith(("A", "B")):
        return color("green")
    return ""


def geomag_style(val):
    s = str(val or "").strip().upper()
    if "STORM" in s or "MAJOR" in s or "SEVERE" in s:
        return color("red", True)
    if "ACTIVE" in s and "INACTIVE" not in s or "UNSETTLED" in s:
        return color("yellow", True)
    if s in ("QUIET", "INACTIVE"):
        return color("green")
    return ""


def launch_status_style(st):
    s = str(st or "").strip().lower()
    if s in ("go", "in flight"):
        return color("green", True)
    if s in ("tbc",):
        return color("yellow", True)
    if s in ("hold",):
        return color("red", True)
    return DIM


def sat_upcoming(sat, now):
    passes = [p for p in (sat.get("passes") or []) if isinstance(p, dict) and (p.get("los") or 0) > now]
    active = next((p for p in passes if (p.get("aos") or 0) <= now <= (p.get("los") or 0)), None)
    return passes, active


def space_summary(space, now):
    """Single summary line under the Space Dashboard header."""
    segs = [("", " ")]
    for sat in (space.get("satellites") or [])[:2]:
        short = clean(sat.get("short") or sat.get("name") or "SAT")
        passes, active = sat_upcoming(sat, now)
        if active:
            segs.append((color("green", True), f"{short} OVERHEAD! LOS {fmt_mmss(active['los'] - now)}"))
        elif passes:
            nxt = passes[0]
            el = nxt.get("maxEl", "?")
            vis = " *VIS" if nxt.get("visible") else ""
            segs.append((color("cyan", True), f"{short} {fmt_tminus(nxt['aos'] - now)}"))
            segs.append((DIM, f" ({el}\xb0{vis})"))
        else:
            segs.append((DIM, f"{short} --"))
        segs.append(("", "   "))
    solar = space.get("solar") if isinstance(space.get("solar"), dict) else None
    if solar:
        segs += [
            (DIM, "SFI "), (BOLD, clean(solar.get("sfi") or "?")), ("", "  "),
            (DIM, "K "), (num_style(solar.get("kIndex"), 3, 5), clean(solar.get("kIndex") or "?")), ("", "  "),
            (DIM, "X-Ray "), (xray_style(solar.get("xray")), clean(solar.get("xray") or "?")), ("", "  "),
            (geomag_style(solar.get("geomag")), clean(solar.get("geomag") or "")),
        ]
    return segs


def pass_block(sat, now):
    name = clean(sat.get("name") or sat.get("short") or "Satellite")
    passes, active = sat_upcoming(sat, now)
    if not passes:
        return [[(BOLD, name)], [(DIM, "  no upcoming passes cached")]]
    if active:
        dur = max(1, (active["los"] - active["aos"]) // 60)
        hdr = [(color("green", True), f"{name}  OVERHEAD NOW!")]
        if active.get("visible"):
            hdr.append((color("yellow", True), "  *VISIBLE"))
        lines = [
            hdr,
            [(color("green", True), "  NOW  "),
             (BOLD, f"max {active.get('maxEl', '?')}\xb0 "),
             ("", f"{compass(active.get('aosAz'))}->{compass(active.get('losAz'))}  "),
             (color("green", True), f"LOS in {fmt_mmss(active['los'] - now)}"),
             (DIM, f" ({dur}m)")],
        ]
        nxt = next((p for p in passes if p is not active), None)
        if nxt:
            ndur = max(1, (nxt["los"] - nxt["aos"]) // 60)
            lines.append([
                (DIM, "  Next "), (color("cyan"), fmt_tminus(nxt["aos"] - now)),
                ("", f"  {fmt_pass_when(nxt['aos'], now, True)}  {nxt.get('maxEl', '?')}\xb0 "
                     f"{compass(nxt.get('aosAz'))}->{compass(nxt.get('losAz'))}  {ndur}m"),
            ])
        return lines

    nxt = passes[0]
    dur = max(1, (nxt["los"] - nxt["aos"]) // 60)
    left = nxt["aos"] - now
    t_style = color("red", True) if left < 600 else color("yellow", True) if left < 3600 else color("cyan", True)
    hdr = [(BOLD, name)]
    if nxt.get("visible"):
        hdr.append((color("yellow", True), "  *VISIBLE NEXT"))
    lines = [
        hdr,
        [(DIM, "  Next "), (t_style, f"{fmt_tminus(left):<10}"),
         ("", f" {fmt_pass_when(nxt['aos'], now, True):<9} "),
         (BOLD, f"{nxt.get('maxEl', '?'):>2}\xb0 "),
         ("", f"{compass(nxt.get('aosAz'))}->{compass(nxt.get('losAz'))}"),
         (DIM, f" {dur}m")],
    ]
    if nxt.get("visible"):
        after = passes[1] if len(passes) > 1 else None
        if after:
            adur = max(1, (after["los"] - after["aos"]) // 60)
            lines.append([
                (DIM, "  Then "), ("", f"{fmt_pass_when(after['aos'], now):<20} "),
                ("", f"{after.get('maxEl', '?'):>2}\xb0 {compass(after.get('aosAz'))}->{compass(after.get('losAz'))}"),
                (DIM, f" {adur}m"),
                (color("yellow", True), " *VIS") if after.get("visible") else ("", ""),
            ])
    else:
        vis = next((p for p in passes[1:] if p.get("visible")), None)
        if vis:
            vdur = max(1, (vis["los"] - vis["aos"]) // 60)
            lines.append([
                (DIM, "  Vis  "), (color("green", True), f"{fmt_pass_when(vis['aos'], now):<20} "),
                ("", f"{vis.get('maxEl', '?'):>2}\xb0 {compass(vis.get('aosAz'))}->{compass(vis.get('losAz'))}"),
                (DIM, f" {vdur}m"),
            ])
        else:
            lines.append([(DIM, "  Vis  no sunlit night pass in next 7d")])
    return lines


