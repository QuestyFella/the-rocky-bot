                          (band_style(night), night)])
        table.append([(DIM, f"VHF NA: Aurora {vhf_rows[0][1]}  E-Skip {vhf_rows[1][1]}")])
    return [idx_lines, table]


def news_items(news, colw, now, limit):
    articles = (news or {}).get("items") or []
    if not articles:
        return [[[(DIM, "no space news cached yet")]]]
    out = []
    for art in articles[:limit]:
        title = clean(art.get("title") or "")
        if not title:
            continue
        wrapped = wrap(title, max(16, colw), max_lines=2)
        lines = [[(BOLD, wrapped[0])]] + [[("", more)] for more in wrapped[1:]]
        meta = [clean(art.get("site") or "")]
        age = fmt_age(art.get("publishedAt"), now)
        if age:
            meta.append(age)
        meta_txt = "  -  ".join(p for p in meta if p)
        if meta_txt:
            lines.append([(DIM, meta_txt)])
        out.append(lines)
    return out or [[[(DIM, "no space news cached yet")]]]


def launch_items(launches, colw, now, limit):
    raw = (launches or {}).get("items") or []
    upcoming = [l for l in raw if isinstance(l, dict) and (l.get("netTs") or 0) > now - 3600]
    if not upcoming:
        return [[[(DIM, "no upcoming launches cached")]]]
    out = []
    for lch in upcoming[:limit]:
        left = lch["netTs"] - now
        if left <= 0:
            cd_txt, cd_style = "T+00:00   ", color("green", True)
        else:
            cd_txt = f"{fmt_tminus(left):<10}"
            cd_style = color("red", True) if left < 3600 else color("yellow", True) if left < 86400 else color("cyan")
        st = clean(lch.get("status") or "")
        name = clean(lch.get("name") or "")
        line1 = [(cd_style, cd_txt), ("", " ")]
        if st:
            line1 += [(launch_status_style(st), f"{st:<4}"), ("", " ")]
        line1.append((BOLD, name))
        prov = clean(PROVIDER_SHORT.get(lch.get("provider"), lch.get("provider") or ""))
        loc = clean(lch.get("location") or "").replace("People's Republic of China", "China")
        if "," in loc:
            parts = [p.strip() for p in loc.split(",")]
            loc = ", ".join(parts[:2])
        detail = "  -  ".join(p for p in (prov, loc) if p)
        block = [line1]
        if detail:
            block.append([(DIM, "  " + detail)])
        out.append(block)
    return out


def space_layout(space, cols, colw, rows, now):
    """Build pages for the Space Dashboard using the same multi-column flow as task boards."""
    loc = space.get("location") if isinstance(space.get("location"), dict) else {}
    place = clean(loc.get("name") or "Guelph, ON")
    sat_hdr = [(color("cyan", True), "STATION PASSES"), (DIM, f"  {place}")]
    sat_items = [pass_block(s, now) for s in (space.get("satellites") or []) if isinstance(s, dict)]
    if not sat_items:
        sat_items = [[[(DIM, "no satellite pass data yet")]]]

    solar = space.get("solar") if isinstance(space.get("solar"), dict) else None
    upd = clean((solar or {}).get("updated") or "")
    solar_hdr = [(color("yellow", True), "HF PROPAGATION"), (DIM, f"  {upd}" if upd else "  N0NBH")]

    news_limit = 6 if (ONCE or cols != 2 or rows > 30) else 4
    launch_limit = 5 if (ONCE or cols != 2 or rows > 30) else 4
    news_hdr = [(color("green", True), "SPACE NEWS"), (DIM, "  Spaceflight News")]
    launch_hdr = [(color("magenta", True), "UPCOMING LAUNCHES"), (DIM, "  Launch Library 2")]

    sections = [
        (sat_hdr, sat_items, False),
        (solar_hdr, solar_items(solar, colw), False),
        (news_hdr, news_items(space.get("news"), colw, now, news_limit), cols >= 2),
        (launch_hdr, launch_items(space.get("launches"), colw, now, launch_limit), cols >= 3),
    ]

    pages, page, col = [], [[] for _ in range(cols)], 0

    def new_col():
        nonlocal page, col
        col += 1
        if col == cols:
            pages.append(page)
            page, col = [[] for _ in range(cols)], 0

    for hdr, items, prefer_new_col in sections:
        if prefer_new_col and page[col]:
            new_col()
        cur = page[col]
        if cur and len(cur) + 3 > rows:
            new_col()
        cur = page[col]
        if cur:
            cur.append([("", "")])
        cur.append(hdr)
        for item in items:
            if len(page[col]) + len(item) > rows:
                new_col()
                page[col].append(hdr[:1] + [(DIM, "  (cont.)")])
            page[col].extend(item)
    if any(page):
        pages.append(page)
    return pages or [[[] for _ in range(cols)]]


