# ANSI colours that also work on the plain Linux console (16 colours)
RESET, BOLD, DIM, REV = "\033[0m", "\033[1m", "\033[2m", "\033[7m"
FG = {"black": 30, "red": 31, "green": 32, "yellow": 33, "blue": 34, "magenta": 35, "cyan": 36, "white": 37}
TAG_COLORS = {"POWER": "yellow", "FIRMWARE": "blue", "RADIO": "magenta", "MECHANICAL": "red",
              "TEST": "cyan", "DECISION": "magenta", "LEGAL": "blue", "FLIGHT DAY": "red", "General": "white"}
CYCLE = ["green", "cyan", "blue", "magenta", "yellow", "red"]


def color(name, bold=False):
    return f"\033[{'1;' if bold else ''}{FG[name]}m"


def tag_color(name):
    return TAG_COLORS.get(name) or CYCLE[sum(map(ord, name)) % len(CYCLE)]


def clean(text):
    """Text safe for the screen. The Linux console font has no emoji, so kiosk mode keeps Latin-1 only."""
    text = " ".join(str(text).split())
    if not KIOSK:
        return text
    out = []
    for ch in unicodedata.normalize("NFKD", text):
        if ord(ch) < 256 and unicodedata.category(ch) != "Mn":
            out.append(ch)
        elif ch in ("\u2018", "\u2019", "\u2032"):
            out.append("'")
        elif ch in ("\u201c", "\u201d", "\u2033"):
            out.append('"')
        elif ch == "\u2026":
            out.append("...")
        elif unicodedata.category(ch) in ("Pd",):
            out.append("-")
    return "".join(out).strip()


def width(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in text)


def fit(text, w):
    """Cut text to w columns, with an ellipsis-style '~' if it was cut."""
    if width(text) <= w:
        return text + " " * (w - width(text))
    out, used = "", 0
    for c in text:
        cw = width(c)
        if used + cw > w - 1:
            break
        out, used = out + c, used + cw
    return out + "~" + " " * (w - used - 1)


# A line is a list of (style, text) segments; render() pads or cuts it to an exact width.
def render(segs, w):
    out, used = [], 0
    for style, text in segs:
        room = w - used
        if room <= 0:
            break
        t = fit(text, room) if width(text) > room else text
        out.append(style + t + RESET)
        used += width(t)
    return "".join(out) + " " * max(0, w - used)


def wrap(text, w, max_lines=2):
    """Word-wrap into at most max_lines lines of w columns (the last one cut with '~' if needed)."""
    words, lines, cur = text.split(), [], ""
    for word in words:
        if cur and width(cur) + 1 + width(word) > w:
            lines.append(cur)
            cur = word
        else:
            cur = f"{cur} {word}" if cur else word
    lines.append(cur)
    if len(lines) > max_lines:
        lines = lines[:max_lines - 1] + [fit(" ".join(lines[max_lines - 1:]), w).rstrip()]
    return lines


def task_lines(t, colw, show_tag):
    key = f"{t['key']:<8} "
    title = (f"[{t['tag']}] " if show_tag else "") + clean(t["title"])
    first, *rest = wrap(title, max(10, colw - 9))
    lines = [[(BOLD, key), ("", first)]] + [[("", " " * 9 + more)] for more in rest]
    facts = []
    if t["owners"]:
        facts.append((color("cyan"), ", ".join(clean(o) for o in t["owners"])))
    if t["due"]:
        if facts:
            facts.append(("", "  "))
        facts.append((color("red", True) if t["overdue"] else DIM, ("OVERDUE " if t["overdue"] else "due ") + t["due"]))
    if facts:
        lines.append([("", " " * 9)] + facts)
    return lines


def blocks(snap, colw):
    """Board sections as (header_line, [task_block, ...]); a task block is 1-2 lines kept together."""
    out = []
    if snap["inProgress"]:
        hdr = [(color("yellow", True), "IN PROGRESS"), (DIM, f"  {len(snap['inProgress'])} being worked on")]
        out.append((hdr, [task_lines(t, colw, True) for t in snap["inProgress"]]))
    for cat in snap["categories"]:
        info = f"  {len(cat['ready'])} ready" + (f" - {cat['waiting']} locked" if cat["waiting"] else "")
        hdr = [(color(tag_color(cat["name"]), True), clean(cat["name"]).upper()), (DIM, info)]
        items = [task_lines(t, colw, False) for t in cat["ready"]] or [[[(DIM, "         nothing to claim right now")]]]
        out.append((hdr, items))
    return out


def layout(snap, cols, colw, rows):
    """Pour sections into columns and pages, newspaper style, never splitting a task."""
    pages, page, col = [], [[] for _ in range(cols)], 0

    def new_col():
        nonlocal page, col
        col += 1
        if col == cols:
            pages.append(page)
            page, col = [[] for _ in range(cols)], 0

    for hdr, items in blocks(snap, colw):
        cur = page[col]
        if cur and len(cur) + 3 > rows:          # header + first task won't fit: next column
            new_col()
        cur = page[col]
        if cur:
            cur.append([("", "")])
        cur.append(hdr)
        for item in items:
            if len(page[col]) + len(item) > rows:
                new_col()
                page[col].append(hdr[:1] + [(DIM, "  (cont.)")])
            page[col].extend(item)
    if any(page):
        pages.append(page)
    return pages or [[[] for _ in range(cols)]]


def launch_text(launch):
    """'T-34d 05:12:09 to HAB launch window', or None if unset or over a day past."""
    if not launch:
        return None
    try:
        target = datetime.fromisoformat(f"{launch['date']}T{launch.get('time') or '00:00'}").timestamp()
    except (KeyError, ValueError):
        return None
    left = int(target - time.time())
    if left < -86400:
        return None
    name = clean(launch.get("name") or "launch")
    if left <= 0:
        return f"{name}: LAUNCH DAY!"
    d, r = divmod(left, 86400)
    return f"T-{d}d {r // 3600:02}:{r % 3600 // 60:02}:{r % 60:02} to {name}"


def load():
    try:
        with open(SNAPSHOT, encoding="utf8") as f:
            return json.load(f), None
    except FileNotFoundError:
        return None, "No board data yet. Is rocky-board-export running?"
    except (OSError, ValueError) as e:
        return None, f"Can't read the board data: {e}"


def load_space():
    """Read the space dashboard snapshot if installed; (None, None) when not set up yet."""
    paths = [SPACE_SNAPSHOT]
    if "ROCKY_SPACE_FILE" not in os.environ:
        fallback = os.path.join(ROOM_DIR, "space.json")
        if fallback != SPACE_SNAPSHOT:
            paths.append(fallback)
    for path in paths:
        try:
            with open(path, encoding="utf8") as f:
                data = json.load(f)
            if not isinstance(data, dict):
                return None, "Space data file is not a JSON object."
            return data, None
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as e:
            return None, f"Can't read space data: {e}"
    return None, None


def load_borrow():
    """Read the borrow tracker snapshot if installed; (None, None) when not set up yet."""
    try:
        with open(BORROW_SNAPSHOT, encoding="utf8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return None, "Borrow data file is not a JSON object."
        return data, None
    except FileNotFoundError:
        return None, None
    except (OSError, ValueError) as e:
        return None, f"Can't read borrow data: {e}"


