    sn = clean(solar.get("sunspots") or "?")
    a_idx = clean(solar.get("aIndex") or "?")
    k_idx = clean(solar.get("kIndex") or "?")
    xray = clean(solar.get("xray") or "?")
    wind = clean(solar.get("solarWind") or "?")
    bz = clean(solar.get("bz") or "?")
    geomag = clean(solar.get("geomag") or "?")
    noise = clean(solar.get("noise") or "")

    idx_lines = [
        [(DIM, "SFI "), (BOLD, sfi), ("", "  "),
