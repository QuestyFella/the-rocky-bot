[Unit]
Description=Club-wide SSO portal and nginx auth_request backend via Gitea OAuth2 (apollo-sso)
After=network-online.target
Wants=network-online.target

[Service]
User=apollo-sso
Group=apollo-sso
ExecStart=/usr/local/bin/apollo-sso
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
