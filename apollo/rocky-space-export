#!/usr/bin/env python3
"""Fetch space dashboard data for apollo's monitor: ISS/Tiangong passes, HF propagation, news, launches.

Runs on a systemd timer (rocky-space-export.timer) as an unprivileged user (rocky-space) and
writes /var/lib/rocky-space/space.json atomically. Each upstream source has its own refresh
interval; if any source fails or rate-limits, the previous cached section is kept so the kiosk
keeps working offline or through transient outages.

Satellite passes are computed locally with near-Earth SGP4 (WGS-72) from CelesTrak TLEs, so the
kiosk counts down live to upcoming passes even without network access for days.
"""
import json
import math
import os
import sys
import time
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone

