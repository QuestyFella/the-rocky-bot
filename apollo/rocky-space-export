SATELLITES = (
    {"norad": 25544, "name": "ISS (ZARYA)", "short": "ISS"},
    {"norad": 48274, "name": "TIANGONG (CSS)", "short": "CSS"},
)

CELESTRAK_URL = "https://celestrak.org/NORAD/elements/gp.php?CATNR={norad}&FORMAT=TLE"
SOLAR_URL = "https://www.hamqsl.com/solarxml.php"
NEWS_URL = "https://api.spaceflightnewsapi.net/v4/articles/?limit=8"
LAUNCH_URL = "https://ll.thespacedevs.com/2.2.0/launch/upcoming/?limit=8&mode=list"

