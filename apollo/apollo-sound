def log(text):
    print(text, flush=True)                             # to the journal: journalctl -u apollo-sound


def read_json(path):
    try:
        with open(path, encoding="utf8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, value):
    """Readers (the bot) never see half a file."""
    temporary = f"{path}.{os.getpid()}.tmp"
    with open(temporary, "w", encoding="utf8") as f:
        json.dump(value, f)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def tune_notes(bpm, notes):
    """[(Hz, seconds sounding, seconds in all)], timed exactly like the doorbell's playDoorbellMelody."""
    out, ticks, elapsed_ms = [], 0, 0
    for note in notes.split():
        pitch, length, triplet, gate = re.fullmatch(r"(-|\d+|[A-G]s?\d):(\d+)(t?)(?:/(\d+))?", note).groups()
        hz = 0 if pitch == "-" else int(pitch) if pitch.isdigit() else PITCHES[pitch]
        ticks += int(length) * (2 if triplet else 3)    # 24 ticks to a quarter note
        end_ms = (ticks * 2500 + bpm // 2) // bpm       # 2500 = 60000 ms / 24 ticks
        duration = end_ms - elapsed_ms
        sounding = duration * int(gate or 90) // 100 if hz else duration
        out.append((hz, sounding / 1000, duration / 1000))
        elapsed_ms = end_ms
    return out


def write_tune(path, bpm, notes, rate=22050):
    """The tune as a WAV: a soft square-ish tone, faded in and out so notes don't click."""
    samples = array.array("h")
    for hz, sounding, duration in tune_notes(bpm, notes):
        n, total = int(rate * sounding), int(rate * duration)
        fade = max(1, min(int(rate * 0.006), n // 2))
        step = 2 * math.pi * (hz / 2) / rate             # an octave down
        for i in range(n):
            env = min(1.0, i / fade, (n - i) / fade)
            samples.append(int(20000 * env * (math.sin(step * i) + math.sin(3 * step * i) / 3)))
        samples.extend([0] * (total - n))
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(samples.tobytes())


def youtube_url(text):
    """text if it's a YouTube link, else None. Only YouTube: any other link could point yt-dlp
    at apollo's own services or the campus network."""
    try:
        url = urlparse(text)
        host = (url.hostname or "").lower()
    except ValueError:
        return None
    return text if url.scheme in ("http", "https") and host in YOUTUBE_HOSTS else None


def fresh(buzz):
    try:
        at = datetime.fromisoformat(buzz["at"].replace("Z", "+00:00")).timestamp()
    except (KeyError, ValueError, AttributeError):
        return False
    return time.time() - at < FRESH_SECONDS


def play_file(path, limit):
    """Play a WAV to the end, but never for longer than limit seconds."""
    try:
        subprocess.run(["aplay", "-q", path], timeout=limit, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        log(f"gave up on {os.path.basename(path)} after {limit}s")


class Speakers:
    """Songs play one after another in the background; tunes and speech play in front, pausing the song."""

    def __init__(self):
        self.lock = threading.Condition()
        self.songs, self.playing, self.results = [], None, []
        self.mpv, self.ducked, self.dirty = None, False, True
        self.front = queue.Queue()        # ("tune", path) or ("say", text)
        self.lookups = queue.Queue()      # !play requests waiting for yt-dlp
        self.tunes, self.last_tune = {}, None
        self.mpv_socket = os.path.join(SOUND_DIR, "mpv.sock")

    # -- requests from the bot ------------------------------------------------------------------
    def handle(self, request):
        if not isinstance(request, dict) or not request.get("id"):
            return
        kind = request.get("type")
        if kind == "say":
            text = " ".join(str(request.get("text") or "").split())[:MAX_SAY_CHARS]
            if text and self.front.qsize() < MAX_WAITING:
                self.front.put(("say", text))
        elif kind == "play":
            self.lookups.put(request)
        elif kind == "skip":
            self.answer(request["id"], ok=self.skip(request.get("songId")))

    def answer(self, request_id, **fields):
        with self.lock:
            self.results = (self.results + [{"id": request_id, "at": int(time.time() * 1000), **fields}])[-30:]
            self.dirty = True

    def ring(self):
        if not self.tunes or self.front.qsize() >= MAX_WAITING:
            return
        name = random.choice([n for n in self.tunes if n != self.last_tune] or list(self.tunes))
        self.last_tune = name
        log(f"!buzz: playing {name}")
        self.front.put(("tune", self.tunes[name]))

    def skip(self, song_id):
        with self.lock:
            if not (self.playing and self.playing["id"] == song_id and self.mpv):
                return False
            player, title = self.mpv, self.playing["title"]
        log(f"skipping {title}")
        player.terminate()
        threading.Timer(3, lambda: player.poll() is None and player.kill()).start()
        return True

    # -- !play: find the song ----------------------------------------------------------------------
    def find_song(self, request):
        query = " ".join(str(request.get("query") or "").split())[:200]
        if not query:
            return {"error": "not-found"}
        with self.lock:
            if len(self.songs) >= MAX_QUEUE:
                return {"error": "queue-full"}
            if sum(s["byId"] == request.get("byId") for s in self.songs) >= MAX_PER_PERSON:
                return {"error": "too-many"}
        target = youtube_url(query) or f"ytsearch1:{query}"
        try:
            found = subprocess.run(["yt-dlp", *YTDLP_OPTIONS, "--skip-download", "--print",
                                    "%(duration)s\t%(webpage_url)s\t%(title)s", "--", target],
                                   capture_output=True, text=True, timeout=LOOKUP_SECONDS, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            log(f"yt-dlp took over {LOOKUP_SECONDS}s for {query!r}")
            return {"error": "failed"}
        line = next((l for l in found.stdout.splitlines() if l.count("\t") >= 2), None)
        if not line:
            if found.returncode:
                log(f"yt-dlp failed for {query!r}: {(found.stderr.strip().splitlines() or ['?'])[-1]}")
                return {"error": "failed"}
            return {"error": "not-found"}
        duration, url, title = line.split("\t", 2)
        if not re.fullmatch(r"\d+(\.\d+)?", duration):
            return {"error": "live", "title": title}
        if float(duration) > MAX_SONG_SECONDS:
            return {"error": "too-long", "title": title, "duration": int(float(duration))}
        if not youtube_url(url):                          # only ever hand mpv a YouTube page
            return {"error": "not-found"}
        song = {"id": request["id"], "title": title, "duration": int(float(duration)), "url": url,
                "by": str(request.get("by") or "someone"), "byId": request.get("byId")}
        with self.lock:
            self.songs.append(song)
            ahead = len(self.songs) - 1 + (1 if self.playing else 0)
            self.dirty = True
            self.lock.notify_all()
        log(f"queued {title} for {song['by']}")
        return {"ok": True, "title": title, "duration": song["duration"], "ahead": ahead}

    def lookup_worker(self):
        while True:
            request = self.lookups.get()
            try:
                result = self.find_song(request)
            except Exception:
                traceback.print_exc()
                result = {"error": "failed"}
            self.answer(request["id"], **result)

    # -- the speakers ------------------------------------------------------------------------------
    def duck(self, on):
        """Pause (or resume) the song while a tune or !say plays."""
        with self.lock:
            self.ducked = on
            if not self.mpv:
                return
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.settimeout(1)
                s.connect(self.mpv_socket)
                s.sendall(json.dumps({"command": ["set_property", "pause", on]}).encode() + b"\n")
        except OSError:
            pass

    def front_worker(self):
        while True:
            kind, value = self.front.get()
            self.duck(True)
            try:
                if kind == "tune":
                    play_file(value, TUNE_SECONDS)
                else:
                    speech = os.path.join(SOUND_DIR, "say.wav")
                    subprocess.run(["espeak-ng", "-s", "165", "-w", speech, "--stdin"], input=value.encode(),
                                   timeout=20, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    play_file(speech, SAY_SECONDS)
            except Exception:
                traceback.print_exc()
            if self.front.empty():
                self.duck(False)

    def music_worker(self):
        while True:
            with self.lock:
                while not self.songs:
                    self.lock.wait()
                song = self.playing = self.songs.pop(0)
                self.dirty = True
                command = ["mpv", "--no-config", "--no-video", "--no-terminal", "--ao=alsa",
                           f"--volume={MUSIC_VOLUME}", f"--input-ipc-server={self.mpv_socket}",
                           "--ytdl-format=bestaudio/best", "--ytdl-raw-options=js-runtimes=node,no-playlist=",
                           f"--pause={'yes' if self.ducked else 'no'}", "--", song["url"]]
                try:
                    self.mpv = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except OSError as error:
                    log(f"can't start mpv: {error}")
            log(f"playing {song['title']}")
            if self.mpv:
                try:
                    self.mpv.wait(timeout=song["duration"] + 90)      # room for pauses and buffering
                except subprocess.TimeoutExpired:
                    log(f"gave up on {song['title']}: still playing well past its length")
                    self.mpv.kill()
                    self.mpv.wait()
            with self.lock:
                self.mpv, self.playing, self.dirty = None, None, True

    # -- state for the bot -------------------------------------------------------------------------
    def write_state(self):
        public = lambda s: s and {k: s[k] for k in ("id", "title", "duration", "url", "by", "byId")}
        with self.lock:
            state = {"updatedAt": int(time.time() * 1000), "playing": public(self.playing),
                     "queue": [public(s) for s in self.songs], "results": self.results}
            self.dirty = False
        write_json(STATE_FILE, state)

    def load_tunes(self):
        tune_dir = os.path.join(SOUND_DIR, "tunes")
        os.makedirs(tune_dir, exist_ok=True)
        for name, (bpm, notes) in TUNES.items():
            path = os.path.join(tune_dir, name.lower().replace(" ", "-") + ".wav")
            write_tune(path, bpm, notes)
            self.tunes[name] = path

    def run(self):
        os.makedirs(REQUEST_DIR, exist_ok=True)
        self.load_tunes()
        for worker in (self.front_worker, self.music_worker, self.lookup_worker):
            threading.Thread(target=worker, daemon=True).start()
        seen = (read_json(BUZZ_FILE) or {}).get("id")       # never ring for a buzz from before we started
        written = 0
        log(f"ready: {len(self.tunes)} tunes; requests in {REQUEST_DIR}")
        while True:
            buzz = read_json(BUZZ_FILE)
            if isinstance(buzz, dict) and buzz.get("id") and buzz["id"] != seen:
                seen = buzz["id"]
                if fresh(buzz):
                    self.ring()
            for name in sorted(os.listdir(REQUEST_DIR)):
                if name.startswith(".") or not name.endswith(".json"):
                    continue
                path = os.path.join(REQUEST_DIR, name)
                request = read_json(path)
                try:
                    os.remove(path)
                except OSError as error:                       # can't remove it: don't handle it every loop
                    log(f"can't remove request {name}: {error}")
                    continue
                self.handle(request)
            if self.dirty or time.time() - written > HEARTBEAT_SECONDS:
                self.write_state()
                written = time.time()
            time.sleep(0.25)


if __name__ == "__main__":
    Speakers().run()
