#!/usr/bin/env python3
"""apollo-sound: the one program that plays apollo's club-room speakers (apollo-sound.service).

  !buzz        one of the doorbell's eight tunes, never the same one twice in a row
  !say text    spoken by piper's natural voice (install-piper.sh), or espeak-ng's robot one without it
  !play song   a YouTube search or link, queued; music pauses while a tune or !say plays
  !skip        stops the song (the rocky bot counts the votes)

The rocky bot writes one JSON file per request into REQUEST_DIR and reads STATE_FILE back for
!queue and its replies. !buzz comes from buzz.json, the same file apollo's monitor shows.
Every sound has a time limit, so one stuck player can never silence the room again.
"""
import array
import json
import math
import os
import queue
import random
import re
import socket
import subprocess
import threading
import time
import traceback
import wave
from datetime import datetime
from urllib.parse import urlparse

SOUND_DIR = os.environ.get("APOLLO_SOUND_DIR", "/var/lib/apollo-sound")
REQUEST_DIR = os.path.join(SOUND_DIR, "requests")      # the bot can write here (install.sh sets the group)
STATE_FILE = os.path.join(SOUND_DIR, "state.json")
BUZZ_FILE = os.path.join(os.environ.get("ROCKY_ROOM_DIR", "/var/lib/rocky-board"), "buzz.json")
MUSIC_VOLUME = os.environ.get("APOLLO_MUSIC_VOLUME", "60")   # percent; tunes and !say play at full volume
FRESH_SECONDS = 120          # like the monitor: a buzz older than this (the bot was down) never rings
MAX_SONG_SECONDS = 600
MAX_QUEUE, MAX_PER_PERSON = 20, 3
MAX_SAY_CHARS = 300
MAX_WAITING = 5              # tunes and speech waiting to play; more than that are dropped
HEARTBEAT_SECONDS = 15       # STATE_FILE is rewritten at least this often; the bot reads an old one as "not running"
TUNE_SECONDS, SAY_SECONDS = 30, 60
LOOKUP_SECONDS = 60
WAKE_SECONDS = 0.5           # silence first: apollo's sound chip sleeps after 10 idle seconds and clips what plays as it wakes
SPEECH_PEAK = 30000          # speech is much quieter than the tunes; its loudest moment is turned up to this
SPEECH_BOOST = float(os.environ.get("APOLLO_SPEECH_BOOST", "5"))   # then its quieter parts up to this much more; 1 is barely any
PIPER = os.environ.get("APOLLO_PIPER", "/usr/bin/piper-tts")     # the AUR's piper-tts-bin
PIPER_VOICE = os.environ.get("APOLLO_PIPER_VOICE",
                             "/usr/share/piper-voices/en/en_US/lessac/medium/en_US-lessac-medium.onnx")
YOUTUBE_HOSTS = {"youtube.com", "www.youtube.com", "m.youtube.com", "music.youtube.com", "youtu.be"}
YTDLP_OPTIONS = ["--js-runtimes", "node", "--no-playlist", "--no-warnings"]   # node: YouTube's JS challenges

# The doorbell's tunes (WiFi-Doorbell: pizerdoor/r4_ethernet/doorbell_melody.h), played an octave lower:
