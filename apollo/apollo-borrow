    discord: $("f-discord").value,
    item: $("f-item").value,
    qty: $("f-qty").value,
    unit: $("f-unit").value,
    notes: $("f-notes").value,
  };
  const headers = { "Content-Type": "application/json" };
  const pin = getPin();
  if (pin) headers["X-Borrow-Pin"] = pin;
  try {
    const res = await fetch("./api/loans", {
      method: "POST", headers, body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok) {
      setMsg(data.error || "Could not save loan.", true);
      return;
    }
    $("f-item").value = "";
    $("f-qty").value = "1";
    $("f-notes").value = "";
    setMsg("Logged: " + data.qtyText + " " + data.unit + " " + data.item + " (" + data.borrower + ")", false);
    tab = "active";
    await load();
  } catch (e) {
    setMsg("Network error: " + e.message, true);
  }
});

$("tab-active").addEventListener("click", () => { tab = "active"; render(); });
$("tab-history").addEventListener("click", () => { tab = "history"; render(); });
$("search").addEventListener("input", render);

load();
setInterval(load, 15000);
</script>
</body>
</html>
"""


def make_handler(store):
    class BorrowHandler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))
            sys.stderr.flush()

        def _send(self, code, body, content_type, extra_headers=None):
            data = body.encode("utf8") if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra_headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def _send_json(self, code, obj):
            self._send(code, json.dumps(obj, ensure_ascii=False), "application/json; charset=utf-8")

        def _read_json(self):
            try:
                length = int(self.headers.get("Content-Length") or "0")
            except ValueError:
                return None, "Invalid Content-Length."
            if length > MAX_BODY:
                return None, "Request body too large."
            raw = self.rfile.read(length) if length > 0 else b"{}"
            try:
                data = json.loads(raw.decode("utf8"))
            except (UnicodeDecodeError, ValueError):
                return None, "Invalid JSON."
            if not isinstance(data, dict):
                return None, "JSON body must be an object."
            return data, None

        def _is_proxied(self):
            return bool(self.headers.get("X-Forwarded-For"))

        def _check_pin(self, payload):
            if not self._is_proxied():
                return True
            required = store.read_pin()
            if not required:
                return True
            supplied = (self.headers.get("X-Borrow-Pin") or str(payload.get("pin") or "")).strip()
            return hmac.compare_digest(supplied, required)

        def do_GET(self):
            path = urlparse(self.path).path
            if path in ("/", "/index.html"):
                self._send(200, HTML_PAGE, "text/html; charset=utf-8")
            elif path == "/api/loans":
                self._send_json(200, store.get_state())
            elif path == "/api/export.csv":
                buf = io.StringIO()
                w = csv.writer(buf)
                w.writerow(["id", "borrower", "discord", "item", "qty", "remaining", "unit", "notes", "source", "borrowed_at", "returned_at"])
                for loan in store.all_loans():
                    w.writerow([
                        loan["id"], csv_safe(loan["borrower"]), csv_safe(loan["discord"]),
                        csv_safe(loan["item"]), loan["qtyText"], loan["remainingText"],
                        csv_safe(loan["unit"]), csv_safe(loan["notes"]), loan["source"],
                        loan["borrowedAt"], loan["returnedAt"] or "",
                    ])
                self._send(
                    200, buf.getvalue(), "text/csv; charset=utf-8",
                    {"Content-Disposition": 'attachment; filename="apollo-borrows.csv"'},
                )
            elif path == "/health":
                self._send_json(200, {"ok": True})
            else:
                self._send_json(404, {"error": "Not found."})

        def do_POST(self):
            path = urlparse(self.path).path
            payload, err = self._read_json()
            if err:
                self._send_json(400, {"error": err})
                return
            if not self._check_pin(payload):
                self._send_json(403, {"error": "Invalid club PIN."})
                return

            if path == "/api/loans":
                req_source = payload.get("source")
                source = "kiosk" if (req_source == "kiosk" and not self._is_proxied()) else "web"
                try:
                    loan = store.create_loan(payload, source=source)
                except ValueError as e:
                    self._send_json(400, {"error": str(e)})
                    return
                self._send_json(201, loan)
                return

            m = RETURN_RE.match(path)
            if m:
                try:
                    loan = store.return_loan(int(m.group(1)), payload.get("qty"))
                except KeyError as e:
                    self._send_json(404, {"error": str(e)})
                    return
                except ValueError as e:
                    self._send_json(400, {"error": str(e)})
                    return
                self._send_json(200, loan)
                return

            self._send_json(404, {"error": "Not found."})

    return BorrowHandler


def main():
    store = BorrowStore(DATA_DIR)
    server = ThreadingHTTPServer((HOST, PORT), make_handler(store))
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"apollo-borrow listening on http://{HOST}:{PORT} (data: {DATA_DIR})", file=sys.stderr, flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
