#!/usr/bin/env python3
"""apollo-borrow: club equipment borrow tracker for apollo (web UI + kiosk backend).

Stores loans in SQLite (/var/lib/apollo-borrow/borrow.db), exports a world-readable snapshot
(/var/lib/apollo-borrow/borrow.json) for rocky-board's kiosk display, and serves a web UI
proxied by nginx at http://10.16.26.107/borrow/.

Optional PIN protection for web writes: if /var/lib/apollo-borrow/pin exists and is non-empty,
requests arriving through nginx (with X-Forwarded-For) must send that PIN; direct loopback calls
from apollo's physical kiosk work without a PIN.
"""
import csv
import hmac
import io
import json
import os
import re
import signal
import sqlite3
import sys
import threading
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

HOST = os.environ.get("APOLLO_BORROW_HOST", "127.0.0.1")
PORT = int(os.environ.get("APOLLO_BORROW_PORT", "3010"))
DATA_DIR = os.environ.get("APOLLO_BORROW_DIR", "/var/lib/apollo-borrow")
DB_PATH = os.path.join(DATA_DIR, "borrow.db")
SNAPSHOT_PATH = os.path.join(DATA_DIR, "borrow.json")
PIN_PATH = os.path.join(DATA_DIR, "pin")

MAX_BODY = 16 * 1024
DEFAULT_UNITS = ("pcs", "kits", "sets", "m", "cm", "rolls", "packs", "spools", "bottles", "boxes")
RETURN_RE = re.compile(r"^/api/loans/([0-9]+)/return$")


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def fmt_qty(val):
    try:
        n = float(val)
    except (TypeError, ValueError):
        return str(val)
    return str(int(n)) if n == int(n) else f"{n:g}"


def clean_text(value, max_len):
    return " ".join(str(value or "").split())[:max_len]


def clean_discord(value):
    s = clean_text(value, 60)
    return s.lstrip("@").strip()


def csv_safe(value):
    s = str(value or "")
    if s and s[0] in ("=", "+", "-", "@", "\t", "\r"):
        return "'" + s
    return s


class BorrowStore:
    def __init__(self, data_dir=DATA_DIR):
        self.data_dir = data_dir
        self.db_path = os.path.join(data_dir, "borrow.db")
        self.snapshot_path = os.path.join(data_dir, "borrow.json")
        self.pin_path = os.path.join(data_dir, "pin")
        self.lock = threading.Lock()
        os.makedirs(self.data_dir, exist_ok=True)
        with self.lock:
            self._init_db()
            self._write_snapshot_locked()

    def _connect(self):
        conn = sqlite3.connect(self.db_path, timeout=10)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA foreign_keys=ON")
        return conn

    def _init_db(self):
        with self._connect() as conn:
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS loans (
                    id          INTEGER PRIMARY KEY AUTOINCREMENT,
                    borrower    TEXT NOT NULL,
                    discord     TEXT NOT NULL,
                    item        TEXT NOT NULL,
                    qty         REAL NOT NULL,
                    remaining   REAL NOT NULL,
                    unit        TEXT NOT NULL,
                    notes       TEXT NOT NULL DEFAULT '',
                    source      TEXT NOT NULL DEFAULT 'web',
                    borrowed_at TEXT NOT NULL,
                    returned_at TEXT
                )
                """
            )
            conn.execute("CREATE INDEX IF NOT EXISTS idx_loans_active ON loans (returned_at, id)")

    def read_pin(self):
        try:
            with open(self.pin_path, encoding="utf8") as f:
                pin = f.read().strip()
            return pin or None
        except OSError:
            return None

    def _row_dict(self, row):
        return {
            "id": row["id"],
            "borrower": row["borrower"],
            "discord": row["discord"],
            "item": row["item"],
            "qty": row["qty"],
            "remaining": row["remaining"],
            "qtyText": fmt_qty(row["qty"]),
            "remainingText": fmt_qty(row["remaining"]),
            "unit": row["unit"],
            "notes": row["notes"],
            "source": row["source"],
            "borrowedAt": row["borrowed_at"],
            "returnedAt": row["returned_at"],
        }

    def _query_state(self, history_limit=100):
        with self._connect() as conn:
            active_rows = conn.execute(
                "SELECT * FROM loans WHERE remaining > 0 ORDER BY id DESC"
            ).fetchall()
            hist_rows = conn.execute(
                "SELECT * FROM loans WHERE remaining <= 0 ORDER BY returned_at DESC, id DESC LIMIT ?",
                (history_limit,),
            ).fetchall()
            items = [r[0] for r in conn.execute(
                "SELECT DISTINCT item FROM loans ORDER BY id DESC LIMIT 60"
            ).fetchall()]
            borrowers = [r[0] for r in conn.execute(
                "SELECT DISTINCT borrower FROM loans ORDER BY id DESC LIMIT 60"
            ).fetchall()]
            units_db = [r[0] for r in conn.execute(
                "SELECT DISTINCT unit FROM loans ORDER BY id DESC LIMIT 30"
            ).fetchall()]
        units = list(dict.fromkeys(list(units_db) + list(DEFAULT_UNITS)))
        return {
            "updatedAt": utc_now(),
            "pinRequired": self.read_pin() is not None,
            "active": [self._row_dict(r) for r in active_rows],
            "history": [self._row_dict(r) for r in hist_rows],
            "suggestions": {"items": items, "borrowers": borrowers, "units": units},
        }

    def _write_snapshot_locked(self):
        state = self._query_state(history_limit=20)
        snap = {
            "updatedAt": state["updatedAt"],
            "active": state["active"],
            "recentReturned": state["history"],
            "suggestions": state["suggestions"],
        }
        tmp = self.snapshot_path + ".tmp"
        with open(tmp, "w", encoding="utf8") as f:
            json.dump(snap, f, ensure_ascii=False, indent=1)
        os.chmod(tmp, 0o644)
        os.replace(tmp, self.snapshot_path)

    def get_state(self):
        with self.lock:
            return self._query_state(history_limit=100)

    def all_loans(self):
        with self.lock:
            with self._connect() as conn:
                rows = conn.execute("SELECT * FROM loans ORDER BY id DESC").fetchall()
            return [self._row_dict(r) for r in rows]

    def create_loan(self, payload, source="web"):
        borrower = clean_text(payload.get("borrower"), 80)
        discord = clean_discord(payload.get("discord"))
        item = clean_text(payload.get("item"), 120)
        unit = clean_text(payload.get("unit"), 30) or "pcs"
        notes = clean_text(payload.get("notes"), 200)
        raw_qty = payload.get("qty", 1)
        try:
            qty = float(str(raw_qty).strip())
        except (TypeError, ValueError):
            raise ValueError("Quantity must be a positive number.")
        if not (0 < qty <= 100000):
            raise ValueError("Quantity must be between 0 and 100000.")
        if not borrower:
            raise ValueError("Name is required.")
        if not discord:
            raise ValueError("Discord username is required.")
        if not item:
            raise ValueError("Item name is required.")

        now = utc_now()
        with self.lock:
            with self._connect() as conn:
                cur = conn.execute(
                    """
                    INSERT INTO loans (borrower, discord, item, qty, remaining, unit, notes, source, borrowed_at)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """,
                    (borrower, discord, item, qty, qty, unit, notes, source, now),
                )
                row = conn.execute("SELECT * FROM loans WHERE id = ?", (cur.lastrowid,)).fetchone()
            self._write_snapshot_locked()
            return self._row_dict(row)

    def return_loan(self, loan_id, qty=None):
        with self.lock:
            with self._connect() as conn:
                row = conn.execute("SELECT * FROM loans WHERE id = ?", (loan_id,)).fetchone()
                if row is None:
                    raise KeyError("Loan not found.")
                if row["remaining"] <= 0:
                    raise ValueError("That item is already returned.")
                if qty is None or str(qty).strip() == "":
                    ret_qty = float(row["remaining"])
                else:
                    try:
                        ret_qty = float(str(qty).strip())
                    except (TypeError, ValueError):
                        raise ValueError("Return quantity must be a positive number.")
                    if ret_qty <= 0:
                        raise ValueError("Return quantity must be greater than zero.")
                new_rem = round(max(0.0, float(row["remaining"]) - ret_qty), 6)
                returned_at = utc_now() if new_rem <= 0 else None
                conn.execute(
                    "UPDATE loans SET remaining = ?, returned_at = ? WHERE id = ?",
                    (new_rem, returned_at, loan_id),
                )
                updated = conn.execute("SELECT * FROM loans WHERE id = ?", (loan_id,)).fetchone()
            self._write_snapshot_locked()
            return self._row_dict(updated)


