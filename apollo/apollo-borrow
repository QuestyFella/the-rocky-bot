<script>
let state = { active: [], history: [], pinRequired: false, suggestions: {} };
let tab = "active";

const $ = (id) => document.getElementById(id);

function getPin() {
  const input = $("f-pin");
  const val = (input && input.value.trim()) || localStorage.getItem("apolloBorrowPin") || "";
  if (input && input.value.trim()) localStorage.setItem("apolloBorrowPin", input.value.trim());
  return val;
}

function relAge(iso) {
  if (!iso) return "";
  const sec = Math.max(0, Math.floor((Date.now() - Date.parse(iso)) / 1000));
  if (sec < 60) return "just now";
  if (sec < 3600) return Math.floor(sec / 60) + "m ago";
  if (sec < 86400) return Math.floor(sec / 3600) + "h ago";
  return Math.floor(sec / 86400) + "d ago";
}

function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  return d.toLocaleString(undefined, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
}

function fillDatalist(id, values) {
  const dl = $(id);
  dl.replaceChildren();
  for (const v of values || []) {
    const opt = document.createElement("option");
    opt.value = v;
    dl.appendChild(opt);
  }
}

function render() {
  const q = $("search").value.trim().toLowerCase();
  const list = (tab === "active" ? state.active : state.history) || [];
  const filtered = q ? list.filter((x) =>
    (x.item + " " + x.borrower + " " + x.discord + " " + (x.notes || "")).toLowerCase().includes(q)
  ) : list;

  $("list-heading").textContent = tab === "active" ? "currently borrowed" : "returned history";
  $("count-label").textContent = tab === "active"
    ? (state.active.length + " item" + (state.active.length === 1 ? "" : "s") + " out")
    : (state.history.length + " returned");

  $("tab-active").classList.toggle("active", tab === "active");
  $("tab-history").classList.toggle("active", tab === "history");

  $("pin-field").classList.toggle("show", !!state.pinRequired);
  $("pin-hint").textContent = state.pinRequired ? "PIN required for web changes" : "campus LAN";
  if (state.pinRequired && !$("f-pin").value) {
    $("f-pin").value = localStorage.getItem("apolloBorrowPin") || "";
  }

  const tbody = $("rows");
  tbody.replaceChildren();
  if (!filtered.length) {
    const tr = document.createElement("tr");
    const td = document.createElement("td");
    td.colSpan = 5;
    td.className = "empty";
    td.textContent = q ? "No matching records." : (tab === "active" ? "Nothing is borrowed right now." : "No returned items yet.");
    tr.appendChild(td);
    tbody.appendChild(tr);
    return;
  }

  for (const loan of filtered) {
    const tr = document.createElement("tr");

    const tdItem = document.createElement("td");
    const itemName = document.createElement("div");
    itemName.textContent = loan.item;
    const badge = document.createElement("span");
    badge.className = "badge " + (loan.source === "kiosk" ? "kiosk" : "");
    badge.textContent = loan.source || "web";
    itemName.appendChild(badge);
    tdItem.appendChild(itemName);
    if (loan.notes) {
      const n = document.createElement("div");
      n.className = "meta";
      n.textContent = loan.notes;
      tdItem.appendChild(n);
    }

    const tdQty = document.createElement("td");
    tdQty.className = "qty";
    if (tab === "active" && loan.remaining !== loan.qty) {
      tdQty.textContent = loan.remainingText + " / " + loan.qtyText + " " + loan.unit;
    } else {
      tdQty.textContent = (tab === "active" ? loan.remainingText : loan.qtyText) + " " + loan.unit;
    }

    const tdWho = document.createElement("td");
    const whoName = document.createElement("div");
    whoName.textContent = loan.borrower;
    const whoDisc = document.createElement("div");
    whoDisc.className = "discord";
    whoDisc.textContent = "@" + loan.discord;
    tdWho.appendChild(whoName);
    tdWho.appendChild(whoDisc);

    const tdWhen = document.createElement("td");
    const ageDays = (Date.now() - Date.parse(loan.borrowedAt)) / 86400000;
    const w1 = document.createElement("div");
    w1.textContent = tab === "active" ? relAge(loan.borrowedAt) : ("ret " + relAge(loan.returnedAt));
    if (tab === "active" && ageDays >= 14) w1.className = "stale";
    const w2 = document.createElement("div");
    w2.className = "meta";
    w2.textContent = fmtDate(loan.borrowedAt) + (loan.returnedAt ? " -> " + fmtDate(loan.returnedAt) : "");
    tdWhen.appendChild(w1);
    tdWhen.appendChild(w2);

    const tdAct = document.createElement("td");
    if (tab === "active") {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "ret";
      btn.textContent = "Return";
      btn.addEventListener("click", () => handleReturn(loan));
      tdAct.appendChild(btn);
    } else {
      const done = document.createElement("span");
      done.className = "meta";
      done.textContent = "returned";
      tdAct.appendChild(done);
    }

    tr.append(tdItem, tdQty, tdWho, tdWhen, tdAct);
    tbody.appendChild(tr);
  }
}

async function handleReturn(loan) {
  let body = {};
  if (loan.remaining > 1) {
    const ans = prompt(
      "Return how many " + loan.unit + " of '" + loan.item + "'? (out: " + loan.remainingText + ")",
      loan.remainingText
    );
    if (ans === null) return;
    body.qty = ans.trim();
  } else if (!confirm("Mark '" + loan.item + "' (" + loan.remainingText + " " + loan.unit + ") returned?")) {
    return;
  }
  const headers = { "Content-Type": "application/json" };
  const pin = getPin();
  if (pin) headers["X-Borrow-Pin"] = pin;
  try {
    const res = await fetch("./api/loans/" + loan.id + "/return", {
      method: "POST", headers, body: JSON.stringify(body)
    });
    const data = await res.json();
    if (!res.ok) {
      setMsg(data.error || "Could not return item.", true);
      return;
    }
    setMsg("Returned " + loan.item + ".", false);
    await load();
  } catch (e) {
    setMsg("Network error: " + e.message, true);
  }
}

function setMsg(text, isErr) {
  const el = $("form-msg");
  el.textContent = text;
  el.className = "msg " + (isErr ? "err" : "ok");
}

async function load() {
  try {
    const res = await fetch("./api/loans", { cache: "no-store" });
    if (!res.ok) return;
    state = await res.json();
    fillDatalist("dl-items", state.suggestions.items);
    fillDatalist("dl-borrowers", state.suggestions.borrowers);
    fillDatalist("dl-units", state.suggestions.units);
    $("updated-at").textContent = "updated " + new Date().toLocaleTimeString();
    render();
  } catch (_) {}
}

$("borrow-form").addEventListener("submit", async (ev) => {
  ev.preventDefault();
  setMsg("Saving...", false);
  const payload = {
